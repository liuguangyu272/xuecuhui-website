{
  "name": "xuecuhui-website",
  "version": "1.0.0",
  "description": "面向药学院学生的学习平台，将学院公告、活动信息、学习资料与药学课程练习集中在一个入口。网站提供药物分析、药剂学题库和药物化学分子记忆卡片，并配有网站内容台与题库内容台，供维护者更新内容。",
  "private": true,
  "scripts": {
    "build:reader": "node tools/build-reader.cjs",
    "test:reader": "node deploy/test_reader.cjs",
    "test:cms": "node deploy/test_cms_frontend.cjs",
    "test:events": "node deploy/test_event_ui.cjs"
  },
  "type": "commonjs",
  "dependencies": {
    "dompurify": "3.4.17",
    "highlight.js": "11.12.0",
    "katex": "0.19.1",
    "markdown-it": "15.0.3",
    "markdown-it-texmath": "1.0.0",
    "pdfjs-dist": "6.5.438",
    "smiles-drawer": "2.4.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.65.0"
  }
}
